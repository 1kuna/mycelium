[Unit]
Description=Mycelium v2 CPU queue
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/.local/share/myce
Environment=GOMAXPROCS=1
PrivateDevices=no
NoNewPrivileges=yes
Nice=10
CPUQuota=25%
MemoryMax=512M
TasksMax=64
EnvironmentFile=%h/.config/myce/queue.env
ExecStart=%h/.local/bin/myce queue --listen REPLACE_QUEUE_IP:7331 --db %h/.local/share/myce/queue.db --checkpoints REPLACE_CHECKPOINT_ROOT --restart-grace 3m --production-loss-timeout 5s --deadline-loss-timeout 20s --experiment-loss-timeout 60s
Restart=on-failure
RestartSec=5
UMask=0077
TimeoutStopSec=150

[Install]
WantedBy=default.target
