# Short bounded callback; never waits for another application holding the lock.
ACTION=="add", SUBSYSTEM=="drm", KERNEL=="card[0-9]*", KERNEL!="card[0-9]*-*", DRIVERS=="xe", RUN+="/usr/bin/timeout --verbose --kill-after=2 10 /usr/local/libexec/myce-xe-preempt-timeout apply --nonblocking-lock --card %k"
