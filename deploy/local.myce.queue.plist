<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>EnvironmentVariables</key>
	<dict>
		<key>MYCE_QUEUE</key>
		<string>http://REPLACE_QUEUE_IP:7331</string>
		<key>MYCE_TOKEN</key>
		<string>REPLACE_PRIVATE_TOKEN</string>
	</dict>
	<key>ExitTimeOut</key>
	<integer>150</integer>
	<key>KeepAlive</key>
	<dict>
		<key>SuccessfulExit</key>
		<false/>
	</dict>
	<key>Label</key>
	<string>local.myce.queue</string>
	<key>ProgramArguments</key>
	<array>
		<string>REPLACE_HOME/.local/bin/myce</string>
		<string>queue</string>
		<string>--listen</string>
		<string>REPLACE_QUEUE_IP:7331</string>
		<string>--db</string>
		<string>REPLACE_HOME/.local/share/myce/queue.db</string>
		<string>--checkpoints</string>
		<string>REPLACE_CHECKPOINT_ROOT</string>
		<string>--restart-grace</string>
		<string>3m</string>
		<string>--production-loss-timeout</string>
		<string>5s</string>
		<string>--deadline-loss-timeout</string>
		<string>20s</string>
		<string>--experiment-loss-timeout</string>
		<string>60s</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>StandardErrorPath</key>
	<string>REPLACE_HOME/.local/share/myce/queue.log</string>
	<key>StandardOutPath</key>
	<string>REPLACE_HOME/.local/share/myce/queue.log</string>
	<key>Umask</key>
	<integer>63</integer>
	<key>WorkingDirectory</key>
	<string>REPLACE_HOME/.local/share/myce</string>
</dict>
</plist>
