# Instance name and physical --device selector are independent.
[Unit]
ConditionPathExists=!%h/.local/share/myce/DISABLED
ConditionPathExists=!%h/.local/share/myce/units/myce-worker@%i.service/DISABLED
Description=Mycelium v2 plain-command worker
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/.local/share/myce
EnvironmentFile=%h/.config/myce/worker.env
ExecStart=%h/.local/bin/myce join --state-dir %h/.local/share/myce/worker-%i --name %H-%i --device REPLACE_DEVICE --gpu REPLACE_GPU --memory-gb REPLACE_BUDGET_GB --reserve-memory-gb REPLACE_RESERVE_GB --heartbeat 1s --checkpoint-root REPLACE_CHECKPOINT_ROOT
Restart=on-failure
RestartSec=5
UMask=0077
# Stop every native descendant, including detached sessions.
KillMode=control-group
SendSIGKILL=yes
TimeoutStopSec=10s

[Install]
WantedBy=default.target
