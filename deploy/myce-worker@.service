# Generic worker template; provision a versioned config with myce install.
# Install as the worker with queue admission disabled. Never run this binary as root.
[Unit]
Description=Mycelium worker
After=network-online.target

[Service]
ExecStart=:REPLACE_WORKER_BINARY service --config REPLACE_CONFIG
EnvironmentFile=REPLACE_GPU_ENVIRONMENT_FILE
Restart=on-failure
RestartSec=3
UMask=0077
Delegate=memory
KillMode=control-group
SendSIGKILL=yes
TimeoutStopSec=45s

[Install]
WantedBy=default.target
