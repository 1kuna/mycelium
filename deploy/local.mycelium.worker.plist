<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
<key>Label</key><string>local.mycelium.worker</string>
<key>ProgramArguments</key><array>
<string>/usr/local/bin/myce</string><string>join</string>
<string>--name</string><string>mac-worker</string>
<string>--gpu</string><string>metal</string>
<string>--memory-gb</string><string>16</string>
<string>--state-dir</string><string>/Users/REPLACE/Library/Application Support/Mycelium/worker</string>
</array>
<key>EnvironmentVariables</key><dict>
<key>MYCE_QUEUE</key><string>http://REPLACE-QUEUE-LAN-IP:7331</string>
<key>MYCE_TOKEN</key><string>REPLACE-WITH-PRIVATE-TOKEN</string>
</dict>
<key>RunAtLoad</key><true/>
<key>KeepAlive</key><true/>
<key>ExitTimeOut</key><integer>150</integer>
<key>StandardOutPath</key><string>/Users/REPLACE/Library/Logs/myce-worker.log</string>
<key>StandardErrorPath</key><string>/Users/REPLACE/Library/Logs/myce-worker.log</string>
</dict></plist>
