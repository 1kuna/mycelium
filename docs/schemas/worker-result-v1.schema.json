          "type": "boolean"
        },
        "forced": {
          "type": "boolean"
        },
        "id": {
          "minLength": 1,
          "type": "string"
        },
        "interrupted": {
          "type": "boolean"
        },
        "machine": {
          "minLength": 1,
          "type": "string"
        },
        "operator_stop": {
          "type": "boolean"
        },
        "out_of_memory": {
          "type": "boolean"
        },
        "output_refs": {
