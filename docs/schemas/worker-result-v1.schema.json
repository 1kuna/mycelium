      },
      "type": [
        "object",
        "null"
      ]
    },
    "FileRef": {
      "properties": {
        "sha256": {
          "type": "string"
        },
        "size_bytes": {
          "type": "integer"
        }
      },
      "required": [
        "sha256",
        "size_bytes"
      ],
      "type": "object"
    },
    "PriorityMatch": {
      "properties": {
        "index": {
