{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/DiskVolume",
  "$defs": {
    "DiskVolume": {
      "properties": {
        "id": {
          "type": "string"
        },
        "roots": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "total_bytes": {
          "type": "integer"
        },
        "free_bytes": {
          "type": "integer"
        },
        "change_bytes_per_hour": {
          "type": "number"
        },
        "sampled_at": {
          "type": "string",
          "format": "date-time",
          "description": "Worker-clock sample timestamp; freshness uses reported age plus queue time since receipt."
        },
        "sample_interval_seconds": {
          "type": "number"
        },
        "age_seconds": {
          "type": "number",
          "description": "Sample age on the worker at check-in; status adds queue-clock time since receipt."
        },
        "retained": {
          "type": "boolean"
        },
        "error": {
          "type": "string"
        }
      },
      "type": "object",
      "required": [
        "roots",
        "total_bytes",
        "free_bytes",
        "sampled_at"
      ]
    }
  }
}
