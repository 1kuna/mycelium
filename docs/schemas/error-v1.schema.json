{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Mycelium HTTP error body v1",
  "description": "Wire bodies emitted by respond from HTTPError. HTTP status is not a JSON property. Messages are sanitized diagnostics; code is stable. submission_key_invalid is HTTP 400 for a key outside 1-128 ASCII characters from A-Z, a-z, 0-9, dot, underscore, colon and hyphen; keyed submit and cancel use the same rule.",
  "type": "object",
  "properties": {
    "error": {
      "type": "string",
      "minLength": 1
    },
    "code": {
      "enum": [
        "job_unknown",
        "submission_key_conflict",
        "submission_key_expired",
        "submission_key_invalid",
        "request_invalid",
        "authentication_required",
        "job_fields_required",
        "job_project_invalid",
        "job_class_invalid",
        "job_execution_invalid",
        "job_spec_invalid",
        "job_logs_invalid",
        "job_priority_invalid",
        "job_deadline_invalid",
        "job_files_invalid",
        "job_program_invalid",
        "job_memory_invalid",
        "job_platform_invalid",
        "job_docker_invalid",
        "job_environment_invalid",
        "job_environment_platform_mismatch",
        "job_placement_invalid",
        "job_capacity_invalid",
        "no_qualified_target",
        "disk_headroom",
        "request_stale",
        "request_failed",
        "request_method_invalid",
        "artifact_unknown",
        "result_expired",
        "extension_version_conflict",
        "extension_invalid",
        "extension_unknown",
        "job_id_ambiguous",
        "policy_revision_conflict",
        "policy_invalid",
        "usage_invalid",
        "usage_unavailable",
        "status_unavailable",
        "model_sync_invalid",
        "model_pin_invalid",
        "model_unpin_invalid",
        "job_submit_failed",
        "job_cancel_invalid",
        "job_logs_invalid_cursor",
        "job_logs_unavailable",
        "worker_checkin_invalid",
        "worker_launch_invalid",
        "worker_start_invalid",
        "worker_complete_invalid",
        "worker_environment_log_invalid",
        "worker_log_invalid",
        "worker_leave_invalid",
        "checkpoint_invalid",
        "host_control_invalid",
        "dev_clock_invalid",
        "worker_protocol_invalid",
        "worker_protocol_mismatch",
        "gpu_selector_invalid",
        "gpu_count_unsupported",
        "machine_renamed",
        "no_matching_device",
        "job_ledger_unavailable",
        "job_ledger_cursor_invalid",
        "native_custody_invalid"
      ]
    },
    "job_id": {
      "type": "string",
      "minLength": 1
    },
    "project": {
      "type": "null"
    },
    "submission_key": {
      "type": "null"
    },
    "state": {
      "const": "unknown"
    },
    "will_not_run": {
      "type": "null"
    },
    "release": {
      "type": "null"
    },
    "acknowledged_at": {
      "type": "null"
    },
    "current_revision": {
      "type": "integer",
      "minimum": 0
    }
  },
  "required": [
    "error",
    "code"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "code": {
            "const": "job_unknown"
          }
        }
      },
      "then": {
        "required": [
          "job_id",
          "project",
          "submission_key",
          "state",
          "will_not_run",
          "release",
          "acknowledged_at"
        ]
      },
      "else": {
        "not": {
          "anyOf": [
            {
              "required": [
                "job_id"
              ]
            },
            {
              "required": [
                "project"
              ]
            },
            {
              "required": [
                "submission_key"
              ]
            },
            {
              "required": [
                "state"
              ]
            },
            {
              "required": [
                "will_not_run"
              ]
            },
            {
              "required": [
                "release"
              ]
            },
            {
              "required": [
                "acknowledged_at"
              ]
            }
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "code": {
            "const": "policy_revision_conflict"
          }
        }
      },
      "then": {
        "required": [
          "current_revision"
        ]
      }
    }
  ]
}
