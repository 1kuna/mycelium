{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/FileStoreStatus",
  "$defs": {
    "ControlStorageStatus": {
      "properties": {
        "database_bytes": {
          "type": "integer"
        },
        "wal_bytes": {
          "type": "integer"
        },
        "shared_bytes": {
          "type": "integer"
        },
        "allocated_bytes": {
          "type": "integer"
        }
      },
      "type": "object",
      "required": [
        "database_bytes",
        "wal_bytes",
        "shared_bytes",
        "allocated_bytes"
      ]
    },
    "FileStoreStatus": {
      "properties": {
        "admission": {
          "$ref": "#/$defs/StorageAdmissionStatus"
        },
        "physical": {
          "$ref": "#/$defs/PhysicalStorageStatus"
        },
        "unidentified_writes_may_use_reserve": {
          "type": "boolean"
        },
        "unidentified_reserve_admitted_bytes": {
          "type": "integer"
        },
        "production_reserve_bytes": {
          "type": "integer"
        },
        "reserved_output_bytes": {
          "type": "integer"
        },
        "store": {
          "type": "string"
        },
        "used_bytes": {
          "type": "integer"
        },
        "free_bytes": {
          "type": "integer"
        },
        "reclaimable_bytes": {
          "type": "integer"
        },
        "limit_bytes": {
          "type": "integer"
        },
        "disk_free_bytes": {
          "type": "integer"
        },
        "floor_bytes": {
          "type": "integer"
        },
        "error": {
          "type": "string"
        }
      },
      "type": "object",
      "required": [
        "unidentified_writes_may_use_reserve",
        "unidentified_reserve_admitted_bytes",
        "production_reserve_bytes",
        "store",
        "used_bytes",
        "free_bytes",
        "reclaimable_bytes",
        "limit_bytes",
        "disk_free_bytes",
        "floor_bytes"
      ]
    },
    "PhysicalStorageStatus": {
      "properties": {
        "mode": {
          "type": "string"
        },
        "sampled_at": {
          "type": "string",
          "format": "date-time"
        },
        "disk_free_bytes": {
          "type": "integer"
        },
        "remaining_upload_bytes": {
          "type": "integer"
        },
        "reserved_output_bytes": {
          "type": "integer"
        },
        "uncommitted_bytes": {
          "type": "integer",
          "description": "Upper bound only: physical free minus remaining tus lengths and known output commitments. Excludes unqualified control expansion and worker backing; not usable for protected admission."
        },
        "protected_free_bytes": {
          "type": "integer"
        },
        "control": {
          "$ref": "#/$defs/ControlStorageStatus"
        },
        "upload_metadata_bytes": {
          "type": "integer"
        },
        "qualification": {
          "type": "string"
        },
        "error": {
          "type": "string"
        }
      },
      "type": "object",
      "required": [
        "mode",
        "sampled_at",
        "disk_free_bytes",
        "remaining_upload_bytes",
        "reserved_output_bytes",
        "uncommitted_bytes",
        "protected_free_bytes",
        "control",
        "upload_metadata_bytes",
        "qualification"
      ]
    },
    "StorageAdmissionProposal": {
      "properties": {
        "job_id": {
          "type": "string"
        },
        "tier": {
          "type": "string"
        },
        "output_bytes": {
          "type": "integer"
        },
        "admitted": {
          "type": "boolean"
        },
        "reason": {
          "type": "string"
        }
      },
      "type": "object",
      "required": [
        "job_id",
        "tier",
        "output_bytes",
        "admitted"
      ]
    },
    "StorageAdmissionStatus": {
      "properties": {
        "migration": {
          "$ref": "#/$defs/StorageMigrationStatus"
        },
        "mode": {
          "type": "string"
        },
        "yielded_commitments": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "proposals": {
          "items": {
            "$ref": "#/$defs/StorageAdmissionProposal"
          },
          "type": "array"
        }
      },
      "type": "object",
      "required": [
        "mode",
        "proposals"
      ]
    },
    "StorageLegacySettings": {
      "properties": {
        "limit_bytes": {
          "type": "integer"
        },
        "production_reserve_bytes": {
          "type": "integer"
        }
      },
      "type": "object",
      "required": [
        "limit_bytes",
        "production_reserve_bytes"
      ]
    },
    "StorageMigrationStatus": {
      "properties": {
        "saved": {
          "$ref": "#/$defs/StorageLegacySettings"
        },
        "saved_settings_active": {
          "type": "boolean"
        },
        "since": {
          "type": "string",
          "format": "date-time"
        },
        "last": {
          "type": "string",
          "format": "date-time"
        },
        "samples": {
          "type": "integer"
        },
        "comparisons": {
          "type": "integer"
        },
        "disagreements": {
          "type": "integer"
        },
        "consistent_seconds": {
          "type": "number"
        },
        "required_seconds": {
          "type": "number"
        },
        "period_job": {
          "type": "string"
        },
        "completed_cycles": {
          "type": "integer"
        },
        "manual_writer_limits_retirable": {
          "type": "boolean"
        },
        "ready": {
          "type": "boolean"
        },
        "blockers": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "type": "object",
      "required": [
        "saved_settings_active",
        "since",
        "last",
        "samples",
        "comparisons",
        "disagreements",
        "consistent_seconds",
        "required_seconds",
        "completed_cycles",
        "manual_writer_limits_retirable",
        "ready",
        "blockers"
      ]
    }
  }
}
