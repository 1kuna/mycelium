{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/FileStoreStatus",
  "$defs": {
    "ControlStorageStatus": {
      "properties": {
        "database_bytes": {
          "type": "integer"
        },
        "wal_bytes": {
          "type": "integer"
        },
        "shared_bytes": {
          "type": "integer"
        },
        "allocated_bytes": {
          "type": "integer"
        }
      },
      "type": "object",
      "required": [
        "database_bytes",
        "wal_bytes",
        "shared_bytes",
        "allocated_bytes"
      ]
    },
    "FileCollectionStatus": {
      "properties": {
        "passes": {
          "type": "integer"
        },
        "yielded_passes": {
          "type": "integer"
        },
        "deferred_passes": {
          "type": "integer"
        },
        "reclaimed_blobs": {
          "type": "integer"
        },
        "reclaimed_bytes": {
          "type": "integer"
        },
        "pending_candidates": {
          "type": "integer"
        },
        "last_reclaim_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "type": "object",
      "required": [
        "passes",
        "yielded_passes",
        "deferred_passes",
        "reclaimed_blobs",
        "reclaimed_bytes",
        "pending_candidates"
      ]
    },
    "FileStoreStatus": {
      "properties": {
        "physical": {
          "$ref": "#/$defs/PhysicalStorageStatus"
        },
        "unidentified_writes_may_use_reserve": {
          "type": "boolean"
        },
        "unidentified_reserve_admitted_bytes": {
          "type": "integer"
        },
        "production_reserve_bytes": {
          "type": "integer"
        },
        "reserved_output_bytes": {
          "type": "integer"
        },
        "projects": {
          "items": {
            "$ref": "#/$defs/ProjectFileStoreUsage"
          },
          "type": "array"
        },
        "store": {
          "type": "string"
        },
        "used_bytes": {
          "type": "integer"
        },
        "free_bytes": {
          "type": "integer"
        },
        "reclaimable_bytes": {
          "type": "integer"
        },
        "collection": {
          "$ref": "#/$defs/FileCollectionStatus"
        },
        "limit_bytes": {
          "type": "integer"
        },
        "disk_free_bytes": {
          "type": "integer"
        },
        "floor_bytes": {
          "type": "integer"
        },
        "error": {
          "type": "string"
        }
      },
      "type": "object",
      "required": [
        "unidentified_writes_may_use_reserve",
        "unidentified_reserve_admitted_bytes",
        "production_reserve_bytes",
        "store",
        "used_bytes",
        "free_bytes",
        "reclaimable_bytes",
        "limit_bytes",
        "disk_free_bytes",
        "floor_bytes"
      ]
    },
    "PhysicalStorageStatus": {
      "properties": {
        "mode": {
          "type": "string"
        },
        "sampled_at": {
          "type": "string",
          "format": "date-time"
        },
        "disk_free_bytes": {
          "type": "integer"
        },
        "remaining_upload_bytes": {
          "type": "integer"
        },
        "reserved_output_bytes": {
          "type": "integer"
        },
        "uncommitted_bytes": {
          "type": "integer",
          "description": "Upper bound only: physical free minus remaining tus lengths and known output commitments. Excludes unqualified control expansion and worker backing; not usable for protected admission."
        },
        "protected_free_bytes": {
          "type": "integer"
        },
        "control": {
          "$ref": "#/$defs/ControlStorageStatus"
        },
        "upload_metadata_bytes": {
          "type": "integer"
        },
        "qualification": {
          "type": "string"
        },
        "error": {
          "type": "string"
        }
      },
      "type": "object",
      "required": [
        "mode",
        "sampled_at",
        "disk_free_bytes",
        "remaining_upload_bytes",
        "reserved_output_bytes",
        "uncommitted_bytes",
        "protected_free_bytes",
        "control",
        "upload_metadata_bytes",
        "qualification"
      ]
    },
    "ProjectFileStoreUsage": {
      "properties": {
        "project": {
          "type": "string"
        },
        "retained_bytes": {
          "type": "integer"
        },
        "added_bytes_24h": {
          "type": "integer"
        },
        "reserved_output_bytes": {
          "type": "integer"
        },
        "max_retained_file_bytes": {
          "type": "integer"
        },
        "max_added_file_bytes_24h": {
          "type": "integer"
        },
        "reserved_file_bytes": {
          "type": "integer"
        },
        "refusal": {
          "type": "string"
        }
      },
      "type": "object",
      "required": [
        "project",
        "retained_bytes",
        "added_bytes_24h"
      ]
    }
  }
}
