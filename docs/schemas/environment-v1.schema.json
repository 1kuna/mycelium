{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/EnvironmentEntry",
  "$defs": {
    "EnvironmentEntry": {
      "properties": {
        "library": {
          "type": "string"
        },
        "reading_side": {
          "type": "string"
        },
        "resolution_base": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "platforms": {
          "items": {
            "$ref": "#/$defs/EnvironmentPlatform"
          },
          "type": "array"
        }
      },
      "type": "object",
      "required": [
        "library",
        "reading_side",
        "resolution_base",
        "name",
        "platforms"
      ]
    },
    "EnvironmentLockCoverage": {
      "properties": {
        "state": {
          "type": "string"
        },
        "environment": {
          "type": "string"
        },
        "targets": {
          "items": {
            "$ref": "#/$defs/ExecutionTarget"
          },
          "type": "array"
        },
        "unmapped_platforms": {
          "type": "boolean"
        }
      },
      "type": "object",
      "required": [
        "state",
        "targets"
      ]
    },
    "EnvironmentPlatform": {
      "properties": {
        "lock_coverage": {
          "$ref": "#/$defs/EnvironmentLockCoverage"
        },
        "worker_reads": {
          "items": {
            "$ref": "#/$defs/EnvironmentReadObservation"
          },
          "type": "array"
        },
        "platform": {
          "type": "string"
        },
        "backend": {
          "type": "string"
        },
        "key": {
          "type": "string"
        },
        "input_digests": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        }
      },
      "type": "object",
      "required": [
        "platform",
        "backend",
        "key",
        "input_digests"
      ]
    },
    "EnvironmentReadObservation": {
      "properties": {
        "worker": {
          "type": "string"
        },
        "state": {
          "type": "string"
        },
        "path_diagnostic": {
          "$ref": "#/$defs/PathDiagnostic"
        }
      },
      "type": "object",
      "required": [
        "worker",
        "state"
      ]
    },
    "ExecutionTarget": {
      "properties": {
        "os": {
          "type": "string"
        },
        "arch": {
          "type": "string"
        },
        "platform": {
          "type": "string"
        }
      },
      "type": "object",
      "required": [
        "os",
        "arch",
        "platform"
      ]
    },
    "PathDiagnostic": {
      "properties": {
        "field": {
          "type": "string"
        },
        "side": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "resolution_base": {
          "type": "string"
        },
        "cause": {
          "type": "string"
        },
        "companion": {
          "type": "string"
        }
      },
      "type": "object",
      "required": [
        "field",
        "side",
        "path",
        "resolution_base",
        "cause"
      ]
    }
  }
}
